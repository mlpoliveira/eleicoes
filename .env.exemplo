# Copie para ".env" (na raiz do projeto) e preencha. O arquivo .env NUNCA vai para o Git.
# A API lê este arquivo ao iniciar; variáveis já definidas no terminal têm prioridade.

# Caminho do banco DuckDB gerado pela ingestão
ELEICOES_DB=eleicoes.duckdb

# IA "Pergunte aos dados" (API da NVIDIA — build.nvidia.com)
NVIDIA_API_KEY=
# IA_MODELO=meta/llama-3.3-70b-instruct
# IA_BASE_URL=https://integrate.api.nvidia.com/v1
